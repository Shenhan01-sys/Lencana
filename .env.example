# Salin jadi .env — JANGAN commit. .gitignore sudah mengecualikan .env.

# Kunci yang menyiarkan deploy. Pakai kunci burner untuk TESTNET; kunci submission
# adalah kunci yang berbeda (jangan burner — dipakai untuk edit submission).
DEPLOYER_PRIVATE_KEY=

# Alamat penerbit yang masuk whitelist resolver, sekaligus kunci yang boleh mencetak
# artefak soulbound. Dalam rencana produk: kunci agen penerbit atas nama institusi sponsor.
ISSUER_ADDRESS=

# Pembayaran penerbitan ditanggung INSTITUSI SPONSOR (keputusan D23), bukan peserta.
# Agennya yang menandatangani; institusinya yang mengisi saldo dompet ini.
SPONSOR_ADDRESS=
