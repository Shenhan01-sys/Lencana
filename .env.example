# Salin jadi .env — JANGAN commit. .gitignore sudah mengecualikan .env.
#
# Semua nilai di bawah adalah KUNCI BURNER TESTNET. Jangan pakai kunci yang pernah
# memegang dana sungguhan, dan jangan pakai kunci submission portal: yang terakhir
# dibutuhkan untuk MENGEDIT submission setelah 30 Sep, jadi ia tidak boleh ada di
# berkas yang dibaca skrip.

# ============================================================
# 1. Kunci
# ============================================================

# Kunci lapis platform: menyiarkan deploy, memiliki CredentialResolver (satu-satunya yang
# boleh memanggil addIssuer/delistIssuer/relistIssuer), DAN memiliki SoulboundCert.
# Artefak dicetak kunci ini, bukan kunci agennya: mint() hanya mengakui satu owner
# sedangkan penerbitnya banyak dan bukan milik kami (D30).
DEPLOYER_PRIVATE_KEY=

# Agen penerbit #1. Alamatnya yang masuk whitelist resolver, dan kunci inilah yang
# menandatangani attestation-nya sendiri di BAS — kita tidak pernah jadi penerbit
# kredensial orang lain (D30). Dipakai SeedDemo untuk menerbitkan + mencabut.
ISSUER_PRIVATE_KEY=
ISSUER_ADDRESS=

# Agen penerbit #2, pihak ketiga LAIN yang tetap sehat. Hanya untuk adegan delisting di
# SeedDemo: platform menjatuhkan satu agen tanpa membuat kredensial agennya yang lain
# ikut merah. Tanpa ini SeedDemo tidak bisa menjalankan adegan [4].
ISSUER_B_PRIVATE_KEY=
ISSUER_B_ADDRESS=

# ============================================================
# 2. Target chain
# ============================================================

# 97 = BSC testnet (fork lokal anvil memakai chain id yang sama). 56 = BSC mainnet.
CHAIN_ID=97

# Fork lokal: http://127.0.0.1:8545 . Testnet publik: https://bsc-testnet.publicnode.com
# Catatan: endpoint lama yang sering dikutip dokumentasi (data-seed-prebsc-1-s1/-s3)
# terbukti rewel; lihat komentar di foundry.toml sebelum ganti endpoint.
RPC_URL=http://127.0.0.1:8545

# BAS core di chain ini. BUKAN milik kami dan TIDAK di-deploy ulang — keduanya deployment
# resmi yang diverifikasi keberadaannya. Chain 56: 0x247Fe62d887bc9410c3848DF2f322e52DA9a51bC
BAS_ADDRESS=0x6c2270298b1e6046898a322acB3Cbad6F99f7CBD

# Hanya untuk dry-run di fork: isi saldo deployer lewat vm.deal. TIDAK berlaku saat
# broadcast sungguhan (transaksinya akan gagal sendiri), jadi biarkan kosong di publik.
# SIMULATE_TOPUP=true

# ============================================================
# 3. Hasil deploy (diisi setelah DeployCredentials.s.sol)
# ============================================================
# SchemaUID diturunkan dari ALAMAT RESOLVER, jadi dua nilai ini bukan hiasan: salin
# dari out/out/broadcast/DeployCredentials.s.sol/<chain>/run-latest.json, jangan dari log
# yang bisa terpotong.

RESOLVER_ADDRESS=
CERT_ADDRESS=

# Lapis artefak yang MENEGAKKAN D42/D43 (artefak hanya level kursus + mintBatch). Sengaja beda
# alamat dari CERT_ADDRESS: artefak korpus demo berstatus cabut/tangguh tidak bisa dibuat ulang di
# kontrak lain - `mint()` menolak state itu, dan penolakan itulah yang kita peragakan - jadi
# "pindah CERT_ADDRESS" berubah makna menjadi "korpus baru". Nilainya jangan diketik tangan:
# diambil dari app/broadcast/DeployCertOnly.s.sol/97/run-latest.json oleh
# _research/set_live_cert.py, dibuktikan dengan `npm run verify:live-cert`.
LIVE_CERT_ADDRESS=

# ============================================================
# 4. Data contoh untuk `npm run probe` di web/
# ============================================================
# Keempatnya HASH kredensial (deterministik, sama di chain mana pun), bukan uid — uid EAS
# mengandung block.timestamp transaksi aslinya. Nilainya dicetak SeedDemo pass kedua, dan
# bisa dihitung ulang: keccak256(abi.encodePacked("vc:", <peserta>, keccak256(<courseId>))).
# Kurangi satu dan probe akan bilang terus-terang bahwa cakupannya berkurang.
DEMO_HASH=
DEMO_REVOKED_HASH=
DEMO_CHAINED_HASH=
DEMO_DELISTED_HASH=

# ============================================================
# 5. Backend penanda tangan (signer/)
# ============================================================
# BASE_URL masuk ke DALAM dokumen saat ia terbit: URL daftar status dan id kredensial mengikutinya.
# Mengganti host setelah ada kredensial terbit TIDAK mengubah dokumen lama, jadi dokumen yang
# sudah terbit di 127.0.0.1 akan selamanya menunjuk ke sana - terbitkan ulang, jangan menambal.
BASE_URL=http://127.0.0.1:8787
AGENT_SLUG=agent-demo

# Host tempat `npm run publish:edge` menyajikan dokumen yang sudah ditandatangani (lihat
# cloudflare/worker.mjs dan vault/04-Signer-Service/S10). Aturan proyek: kredensial JANGAN pernah
# diterbitkan di bawah host sementara - URL dicetak saat terbit dan tidak pernah berubah, jadi satu
# quick tunnel yang ditarik kembali membuat artefaknya tidak bisa diperiksa siapa pun (B51).
# Nilai ini + CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID diisi dari lingkungan, bukan dari .env,
# dan token dibaca sebelum berkas ini di-load supaya kredensial yang tertempel di sini tak terpakai.
EDGE_BASE_URL=

# Opsional. Kosong = daftar status dibangun dari SEMUA kredensial yang dipantau store
# (terbitan sendiri + hasil `adopt.js`). Mengisinya membuat daftar itu jadi manual, jadi lupa
# mengisinya lebih aman daripada mengisinya separuh.
STATUS_HASHES=

# Untuk scripts/serve-probe.js: apa yang HARUS terlihat di bitstring. Ini UID, bukan hash, dan
# UID yang dipakai adalah yang DIBACA dari chain sesudah penambangan - bukan yang dicetak
# SeedDemo untuk kredensial yang baru ia terbitkan sendiri (rumus UID EAS memuat block.timestamp).
# Tanpa ketiganya serve-probe tetap jalan dan menyebut grup yang dilewati.
# DOC_HASH = credentialHash dari kredensial yang DITERBITKAN oleh AGENT_SLUG yang disajikan
# server ini. `npm run probe:serve` memakainya untuk membuktikan rute /credentials/<hash>
# memulangkan dokumen yang bentuknya benar dan tanda tangannya sah terhadap kunci yang
# disajikan lewat HTTP — bukan rekaman store. Kosong = jatuh ke DEMO_HASH; kalau slug yang
# disajikan bukan yang menerbitkan DEMO_HASH, pemeriksaan tanda tangan akan merah, dan itu
# benar: kunci penerbit lain tidak bisa membuktikan dokumen ini.
DOC_HASH=

# Siapa proses ini menurut DB. `enrollments.origin` (migrasi 0007) membedakan baris peserta nyata
# dari sisa harness, jadi `sisa = 0` (B78) bisa dibuktikan dengan kueri, bukan dengan keyakinan.
#   demo = server yang dipakai orang / yang melahirkan kredensial yang kita pantau
#   test = server yang DINYALAKAN harness (verify:attempts dan verify:db menyetel ini sendiri)
#   kosong = `unknown` — default yang sengaja: proses yang tidak memperkenalkan dirinya
#            tidak boleh menyamar jadi demo.
LANCENA_ORIGIN=demo

EXPECT_REVOKED=
EXPECT_SUSPENDED=
EXPECT_CLEAN=
