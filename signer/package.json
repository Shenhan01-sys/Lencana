{
  "name": "lencana-signer",
  "version": "0.1.0",
  "private": true,
  "description": "Backend penanda tangan OpenBadgeCredential 3.0 (DataIntegrityProof + eddsa-rdfc-2022) dan BitstringStatusList yang diturunkan dari keadaan chain.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "agent": "node scripts/agent.js",
    "adopt": "node scripts/adopt.js --demo",
    "check": "node scripts/check.js",
    "serve": "node src/server.js",
    "probe:serve": "node scripts/serve-probe.js",
    "issue": "node scripts/issue.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@digitalbazaar/data-integrity": "^2.5.0",
    "@digitalbazaar/ed25519-multikey": "^1.0.0",
    "@digitalbazaar/eddsa-rdfc-2022-cryptosuite": "^1.3.0",
    "jsonld": "^9.0.0",
    "jsonld-signatures": "^11.6.0",
    "viem": "^2.56.5"
  }
}
