# Lencana — platform kredensial terverifikasi di BNB Chain.
# Aturan utama: yang bisa diregenerasi JANGAN masuk; yang berisi kunci WAJIB keluar.

# Artefak build Foundry
out/
cache/
broadcast/
verify/

# 🔴 Export sesi (qwen-code `/export`) yang pernah jatuh ke dalam folder ini: 38 MB transkrip,
# berisi path lokal + perintah + keluaran. Repo ini publik — tidak ada alasan satu `git add -A`
# bisa menyeretnya ke `origin/main`. Berkasnya tetap di disk kalau-kalau dibutuhkan; yang dicegah
# cuma masuk ke riwayat git.
qwen-code-export-*.md

# Dependensi yang dipasang ulang
node_modules/
lib/forge-std/

# B148: cache disk konteks JSON-LD selain empat salinan di signer/contexts/ — diambil ulang sendiri kalau hilang
signer/.cache/

# Hasil build frontend — `npm run build` menghasilkannya kembali
dist/
# build khusus terowongan (uji dari HP lewat ngrok + `vite preview`, tanpa live-reload) — diregenerasi, jangan masuk
dist-tunnel/

# 🔴 Secret. `cache/` dan `broadcast/` di atas juga sudah mengecualikan berkas Foundry yang
# menyimpan private key saat `--broadcast`, tapi pola di bawah ini jaring pengamannya.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Kunci Ed25519 agen demo (Multikey, teks) yang dibuat signer/scripts/agent.js.
# `*.key` di atas tidak menangkapnya karena berkasnya ber-ekstensi .json.
.keys/
signer/.keys/

# State runtime signer: catatan alokasi nomor bit + registry kredensial yang sudah terbit.
# Ini STATE, bukan source — dan nomor di dalamnya harus bertahan lintas proses, bukan
# terbablas datang dari repo orang lain.
.store/
signer/.store/

# Editor / OS
.obsidian/
.DS_Store
Thumbs.db

# Cache `wrangler`: state login + artefak build lokal. Yang kita commit dari `cloudflare/` hanya
# source-nya — `wrangler.toml` sengaja berisi alamat publik saja (resolver + RPC), karena kunci
# tanda tangan tidak pernah menyentuh tepi sajian.
.wrangler/
