# Privy login (1 Okt): @privy-io/js-sdk-core 0.77.0 mematok peer OPSIONAL viem persis 2.56.0 dan,
# lewat peer opsional permissionless (smart wallet - tidak kita pakai), ox ^0.8. Halaman ini memakai
# viem 2.56.5 (beda patch) dan tidak memasang permissionless, jadi npm menolak memasang tanpa ini.
# Berkas ini ada supaya `npm --prefix web install` di Vercel dan `npm ci` lokal memasang dengan cara
# yang sama. Kalau Privy melonggarkan patokan viem-nya, hapus berkas ini.
legacy-peer-deps=true
